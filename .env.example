APP_NAME="SEO Operations Platform"
# local | testing | production. Production MUST use APP_ENV=production and APP_DEBUG=false.
APP_ENV=local
# Generate ONCE per environment with `php artisan key:generate`. Never regenerate on an
# existing installation: encrypted data and sessions would become unreadable.
APP_KEY=
APP_DEBUG=true
# Public origin. Production must be https:// (secure cookies, generated links).
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: LOG_CHANNEL=daily with LOG_LEVEL=warning (or info) and a retention window.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use "mysql" for MySQL 8.0+. Use "mariadb" for MariaDB 10.4+ (e.g. XAMPP).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cp_seo_internal_tool
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: SESSION_SECURE_COOKIE=true. Leave unset for local HTTP development.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Comma-separated reverse-proxy / load-balancer IPs or CIDRs whose X-Forwarded-* headers
# are trusted (config/security.php). Leave empty when this server terminates HTTPS itself.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Monthly report PDFs (config/reports.php). Rendered by a headless Chromium-based
# browser. Set CHROMIUM_PATH explicitly in production; leave it empty to auto-detect
# Chrome / Edge / Chromium in their default install locations. CHROMIUM_FLAGS is
# normally empty; add --no-sandbox ONLY inside an isolated container that cannot run
# the sandbox. The PDF disk must be PRIVATE (never "public").
REPORT_PDF_DISK=local
REPORT_PDF_DIRECTORY=reports
CHROMIUM_PATH=
CHROMIUM_TIMEOUT=90
CHROMIUM_FLAGS=

# CSV imports (config/imports.php). Private disk, V1 limits, raw-file retention in days
# (history and row issues are kept after the file is pruned).
IMPORT_DISK=local
IMPORT_DIRECTORY=imports
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_FILE_RETENTION_DAYS=90

# Legacy spreadsheet migration (Milestone 17) has no environment variables: the office
# mapping lives in config/legacy-migration.php or a JSON file passed with --mapping.

# Database queue by default; run a persistent worker (docs/production-deployment.md).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is not used by the V1 application; keep "log" unless a mailer is introduced.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed when REPORT_PDF_DISK / IMPORT_DISK point at the "s3" disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
